# Copy this file to ".env" and fill in your Supabase project values.
# If these are left blank, the app falls back to a local SQLite database.
#
# Find these in Supabase: Project Settings -> API.
#   SUPABASE_URL         = the "Project URL"
#   SUPABASE_SERVICE_KEY = the "service_role" secret key (KEEP SECRET, server only)
#
# The service_role key bypasses Row-Level Security. Never expose it in the
# browser, never commit it. Only this Flask backend uses it.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
